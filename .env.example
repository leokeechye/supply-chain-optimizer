# Supply Chain Optimizer - Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=supply-chain-optimizer
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server
HOST=0.0.0.0
PORT=8000

# =============================================================================
# LLM Configuration (Open Source Options)
# =============================================================================

# Option 1: Ollama (Recommended - fully local/open source)
# Install: https://ollama.ai
# Models: llama3, mistral, codellama, etc.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama4

# Option 2: OpenAI-compatible API (for cloud deployments)
# OPENAI_API_KEY=  # Set in environment, not here
# OPENAI_MODEL=gpt-4o

# =============================================================================
# Vector Store (Open Source)
# =============================================================================

# ChromaDB (local, open source)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# =============================================================================
# Database (Open Source)
# =============================================================================

# PostgreSQL with TimescaleDB extension
# DATABASE_URL=  # Set in environment, not here
# Format: postgresql+asyncpg://user:password@localhost:5432/supply_chain

# SQLite (for development)
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/supply_chain.db

# =============================================================================
# External APIs (Optional - set in environment if needed)
# =============================================================================

# Weather API (OpenWeatherMap has free tier)
# OPENWEATHER_API_KEY=  # Set in environment, not here

# Maps API
# GOOGLE_MAPS_API_KEY=  # Set in environment, not here

# =============================================================================
# Cache (Open Source)
# =============================================================================

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
